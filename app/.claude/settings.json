{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPT_OUT_INSTRUMENTATION": "true",
    "DO_NOT_TRACK": "1",
    "SHOPIFY_CLI_NO_ANALYTICS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/kit/app.mjs:*)",
      "Bash(node .claude/kit/jira.mjs:*)",
      "Bash(node .claude/kit/shopify.mjs --help)",
      "Bash(node .claude/kit/shopify.mjs cli-check:*)",
      "Bash(node .claude/kit/shopify.mjs info:*)",
      "Bash(node .claude/kit/shopify.mjs validate:*)",
      "Bash(node .claude/kit/shopify.mjs dev-status:*)",
      "Bash(node .claude/kit/shopify.mjs generate-extension:*)",
      "Bash(node .claude/kit/shopify.mjs build:*)",
      "Bash(node .claude/kit/shopify.mjs function-build:*)",
      "Bash(node .claude/kit/shopify.mjs function-typegen:*)",
      "Bash(node .claude/kit/shopify.mjs function-run:*)",
      "Bash(node .claude/kit/shopify.mjs security:*)",
      "Bash(node .claude/kit/shopify.mjs query:*)",
      "Bash(node .claude/kit/surfaces.mjs:*)",
      "Bash(node .claude/hooks/guard.mjs --selftest)",
      "Bash(node .claude/hooks/guard.mjs --mode-probe)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git fetch origin:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git push -u origin:*)",
      "Bash(git ls-remote --heads origin:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(npx prisma generate:*)",
      "PowerShell(node .claude/kit/app.mjs:*)",
      "PowerShell(node .claude/kit/jira.mjs:*)",
      "PowerShell(node .claude/kit/shopify.mjs --help)",
      "PowerShell(node .claude/kit/shopify.mjs cli-check:*)",
      "PowerShell(node .claude/kit/shopify.mjs info:*)",
      "PowerShell(node .claude/kit/shopify.mjs validate:*)",
      "PowerShell(node .claude/kit/shopify.mjs dev-status:*)",
      "PowerShell(node .claude/kit/shopify.mjs generate-extension:*)",
      "PowerShell(node .claude/kit/shopify.mjs build:*)",
      "PowerShell(node .claude/kit/shopify.mjs function-build:*)",
      "PowerShell(node .claude/kit/shopify.mjs function-typegen:*)",
      "PowerShell(node .claude/kit/shopify.mjs function-run:*)",
      "PowerShell(node .claude/kit/shopify.mjs security:*)",
      "PowerShell(node .claude/kit/shopify.mjs query:*)",
      "PowerShell(npx vitest run:*)",
      "PowerShell(git status:*)",
      "PowerShell(git fetch origin:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git merge-base:*)",
      "PowerShell(git push -u origin:*)",
      "PowerShell(git ls-remote --heads origin:*)",
      "PowerShell(git branch --list:*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git grep:*)",
      "PowerShell(git blame:*)",
      "PowerShell(npx prisma generate:*)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__kit-browser__browser_find",
      "mcp__kit-browser__browser_navigate",
      "mcp__kit-browser__browser_navigate_back",
      "mcp__kit-browser__browser_resize",
      "mcp__kit-browser__browser_snapshot",
      "mcp__kit-browser__browser_take_screenshot",
      "mcp__kit-browser__browser_evaluate",
      "mcp__kit-browser__browser_click",
      "mcp__kit-browser__browser_hover",
      "mcp__kit-browser__browser_select_option",
      "mcp__kit-browser__browser_press_key",
      "mcp__kit-browser__browser_wait_for",
      "mcp__kit-browser__browser_console_messages",
      "mcp__kit-browser__browser_network_requests",
      "mcp__kit-browser__browser_tabs",
      "mcp__kit-browser__browser_close"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.sqlite-journal)",
      "Read(./prisma/**/*.db)",
      "Read(**/*.db)",
      "Read(**/*.db-journal)",
      "Read(**/*.sqlite-wal)",
      "Read(**/*.sqlite-shm)",
      "Read(**/.envrc)",
      "Read(~/.claude/.env)",
      "Read(~/.git-credentials)",
      "Read(~/AppData/Roaming/shopify-cli-*/**)",
      "Read(~/.config/shopify-cli-*/**)",
      "Read(~/Library/Preferences/shopify-cli-*/**)",
      "Edit(~/AppData/Roaming/shopify-cli-*/**)",
      "Edit(~/.config/shopify-cli-*/**)",
      "Edit(~/Library/Preferences/shopify-cli-*/**)",
      "Bash(shopify app deploy *)",
      "Bash(shopify app release *)",
      "Bash(npx shopify app deploy *)",
      "Bash(npx shopify app release *)",
      "Bash(npm run deploy *)",
      "Bash(pnpm deploy *)",
      "Bash(pnpm run deploy *)",
      "Bash(yarn deploy *)",
      "PowerShell(shopify app deploy *)",
      "PowerShell(shopify app release *)",
      "PowerShell(npx shopify app deploy *)",
      "PowerShell(npx shopify app release *)",
      "PowerShell(npm run deploy *)",
      "PowerShell(pnpm deploy *)",
      "PowerShell(pnpm run deploy *)",
      "PowerShell(yarn deploy *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/kit/update-check.mjs",
              "--hook"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|MultiEdit|NotebookEdit|mcp__kit-browser__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "shopify-ai-toolkit@claude-plugins-official": true
  }
}
